name: Construire Popref pour Windows

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'local_app.py'
      - 'build_windows.py'
      - 'requirements-local.txt'
      - 'popref_core/**'
      - '.github/workflows/build-windows.yml'

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: Récupérer le code
        uses: actions/checkout@v4
      - name: Installer Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Installer les dépendances
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements-local.txt
          python -m pip install .
      - name: Construire Popref.exe
        shell: pwsh
        run: python build_windows.py
      - name: Préparer l'archive de distribution
        shell: pwsh
        run: Compress-Archive -Path dist/Popref/* -DestinationPath Popref-Windows.zip
      - name: Publier l'archive Windows
        uses: actions/upload-artifact@v4
        with:
          name: Popref-Windows
          path: Popref-Windows.zip
          if-no-files-found: error
